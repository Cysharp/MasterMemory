<Project Sdk="Microsoft.NET.Sdk">

	<!-- The uninstrumented side of the SharpFuzz split: this exe hosts Fuzzer.LibFuzzer.Run and is excluded from IL
	     instrumentation (instrumenting the assembly that drives the fuzzing loop corrupts the coverage protocol).
	     Run via fuzz.ps1; see README.md. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- for parking SharpFuzz.Common.Trace.SharedMem on a dummy map (see Program.cs) -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SharpFuzz" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MasterMemory.Tests.Fuzz.Target\MasterMemory.Tests.Fuzz.Target.csproj" />
	</ItemGroup>

</Project>
