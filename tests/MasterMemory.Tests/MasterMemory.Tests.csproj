<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<!-- MasterMemory does not reference it: compression is what an application plugs in. The tests do, to read the
		     databases of v3 (Golden/*.bin), which are compressed, and to write compressed ones. -->
		<PackageReference Include="MessagePack.LZ4" Version="4.0.0-rc.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="Shouldly" Version="4.2.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\MasterMemory\MasterMemory.csproj" />
		<!-- the checks of the Native AOT application, which AotChecksTest runs on the JIT -->
		<ProjectReference Include="..\MasterMemory.Tests.Aot\MasterMemory.Tests.Aot.csproj" />
		<!-- the type-forwarding shim, see AnnotationsForwardTest -->
		<ProjectReference Include="..\..\src\MasterMemory.Annotations\MasterMemory.Annotations.csproj" />
		<!-- the fuzz targets of the lookups, which FindFuzzTest runs on fixed inputs -->
		<ProjectReference Include="..\MasterMemory.Tests.Fuzz.Target\MasterMemory.Tests.Fuzz.Target.csproj" />
		<ProjectReference Include="..\..\src\MasterMemory.SourceGenerator\MasterMemory.SourceGenerator.csproj">
			<OutputItemType>Analyzer</OutputItemType>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup>
		<!-- a database written by MasterMemory 3.0.4, see CompatibilityTest -->
		<None Update="Golden\v3.bin" CopyToOutputDirectory="PreserveNewest" />
		<None Update="Golden\v3-string-keys.bin" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="Xunit.Abstractions" />
		<Using Include="Shouldly" />
	</ItemGroup>

</Project>
